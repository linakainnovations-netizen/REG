# ============================================================
# St. Charles Lwanga Regiment Portal — environment config
# Copy this file to `.env` (same folder, no extension).
# Fill in real values. NEVER commit `.env` to git.
# Dashboard → Settings values override the public links below,
# but SECRETS always come from here (never paste them in Dashboard).
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=st_paul_parish_portal_db
DB_USER=root
DB_PASS=

# --- Base URL (path the portal lives under) ---
BASE_URL=/St_Charles_Lwanga_Regiment_Portal/

# --- Livestream ---
FB_PAGE_URL=https://web.facebook.com/groups/539879469476464/events
YT_CHANNEL_URL=https://www.youtube.com/
YT_CHANNEL_ID=

# --- Online giving (manual MoMo numbers shown on Give page) ---
MOMO_NAME=St. Charles Lwanga Regiment Parish
MOMO_MTN_NUMBER=0975255734
MOMO_AIRTEL_NUMBER=0975255734

# --- Payment gateways (leave empty until parish provides keys) ---
FLUTTERWAVE_PUB_KEY=
FLUTTERWAVE_SECRET_KEY=
DPO_COMPANY_TOKEN=

# --- File storage (OUTSIDE the website folder — never in the project) ---
# Uploads (bulletins) are kept here and sent to browsers as downloads.
# Leave empty for the default (a parish_storage folder next to the web root).
STORAGE_PATH=
